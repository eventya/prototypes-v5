diff --git a/lib/stejar/color_palette.rb b/lib/stejar/color_palette.rb
index 3d6c58d66..036bc9cc4 100644
--- a/lib/stejar/color_palette.rb
+++ b/lib/stejar/color_palette.rb
@@ -23,17 +23,22 @@ module Stejar
       950 => -0.65
     }.freeze
 
+    # Text and buttons use shade 600 and darker, so those hang off a base dark
+    # enough to read on white (WCAG AA) even when the brand color itself is light.
+    READABLE_CONTRAST = 4.5
+
     class << self
       def generate(hex)
         return {} unless hex.present? && hex.match?(/\A#[0-9a-fA-F]{6}\z/)
 
         h, s, l = hex_to_hsl(hex)
+        dark_l = readable_lightness(h, s, l)
 
         SHADES.each_with_object({}) do |(shade, factor), palette|
           adjusted_l = if factor.positive?
                          l + (1.0 - l) * factor
                        elsif factor.negative?
-                         l * (1.0 + factor)
+                         dark_l * (1.0 + factor)
                        else
                          l
                        end
@@ -42,8 +47,29 @@ module Stejar
         end
       end
 
+      def contrast_on_white(hex)
+        1.05 / (relative_luminance(hex) + 0.05)
+      end
+
       private
 
+      def readable_lightness(hue, saturation, lightness)
+        lightness -= 0.01 while lightness.positive? && too_light?(hue, saturation, lightness)
+        lightness.clamp(0.0, 1.0)
+      end
+
+      def too_light?(hue, saturation, lightness)
+        contrast_on_white(hsl_to_hex(hue, saturation, lightness)) < READABLE_CONTRAST
+      end
+
+      def relative_luminance(hex)
+        r, g, b = hex.delete('#').scan(/../).map do |channel|
+          value = channel.to_i(16) / 255.0
+          value <= 0.03928 ? value / 12.92 : ((value + 0.055) / 1.055)**2.4
+        end
+        (0.2126 * r) + (0.7152 * g) + (0.0722 * b)
+      end
+
       def hex_to_hsl(hex)
         r, g, b = hex.delete('#').scan(/../).map { |c| c.to_i(16) / 255.0 }
 
